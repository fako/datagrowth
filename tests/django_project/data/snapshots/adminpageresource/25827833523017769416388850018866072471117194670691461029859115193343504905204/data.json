            "body": "<!DOCTYPE html>\n\n<html lang=\"en-us\" dir=\"ltr\">\n<head>\n<title>Site administration | Django site admin</title>\n<link rel=\"stylesheet\" href=\"/static/admin/css/base.css\">\n\n  <link rel=\"stylesheet\" href=\"/static/admin/css/dark_mode.css\">\n  <script src=\"/static/admin/js/theme.js\"></script>\n\n\n  <link rel=\"stylesheet\" href=\"/static/admin/css/nav_sidebar.css\">\n  <script src=\"/static/admin/js/nav_sidebar.js\" defer></script>\n\n<link rel=\"stylesheet\" href=\"/static/admin/css/dashboard.css\">\n\n\n\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <link rel=\"stylesheet\" href=\"/static/admin/css/responsive.css\">\n    \n\n<meta name=\"robots\" content=\"NONE,NOARCHIVE\">\n</head>\n\n<body class=\" dashboard\"\n  data-admin-utc-offset=\"0\">\n<a href=\"#content-start\" class=\"skip-to-content-link\">Skip to main content</a>\n<!-- Container -->\n<div id=\"container\">\n\n    \n    <!-- Header -->\n    \n      <header id=\"header\">\n        <div id=\"branding\">\n        \n<div id=\"site-name\"><a href=\"/admin/\">Django administration</a></div>\n\n\n        </div>\n        \n        \n        <div id=\"user-tools\">\n            \n                Welcome,\n                <strong>admin</strong>.\n            \n            \n                \n                    <a href=\"/\">View site</a> /\n                \n                \n                    \n                    \n                \n                \n                <a href=\"/admin/password_change/\">Change password</a> /\n                \n                <form id=\"logout-form\" method=\"post\" action=\"/admin/logout/\">\n                    <input type=\"hidden\" name=\"csrfmiddlewaretoken\" value=\"u3QdIQpAj9qyRZ65sgthZ97cYrjPmB6ldb1hbnQzOqsW9U9KrYKu2MKEQHRoAUau\">\n                    <button type=\"submit\">Log out</button>\n                </form>\n                \n<button class=\"theme-toggle\">\n  <span class=\"visually-hidden theme-label-when-auto\">Toggle theme (current theme: auto)</span>\n  <span class=\"visually-hidden theme-label-when-light\">Toggle theme (current theme: light)</span>\n  <span class=\"visually-hidden theme-label-when-dark\">Toggle theme (current theme: dark)</span>\n  <svg aria-hidden=\"true\" class=\"theme-icon-when-auto\">\n    <use xlink:href=\"#icon-auto\" />\n  </svg>\n  <svg aria-hidden=\"true\" class=\"theme-icon-when-dark\">\n    <use xlink:href=\"#icon-moon\" />\n  </svg>\n  <svg aria-hidden=\"true\" class=\"theme-icon-when-light\">\n    <use xlink:href=\"#icon-sun\" />\n  </svg>\n</button>\n\n            \n        </div>\n        \n        \n        \n      </header>\n    \n    <!-- END Header -->\n    \n    \n\n    <div class=\"main\" id=\"main\">\n      \n        \n      \n      <main id=\"content-start\" class=\"content\" tabindex=\"-1\">\n        \n          \n        \n        <!-- Content -->\n        <div id=\"content\" class=\"colMS\">\n          \n          <h1>Site administration</h1>\n          \n          \n<div id=\"content-main\">\n  \n\n\n  \n    <div class=\"app-auth module\">\n      <table>\n        <caption>\n          <a href=\"/admin/auth/\" class=\"section\" title=\"Models in the Authentication and Authorization application\">Authentication and Authorization</a>\n        </caption>\n        <thead class=\"visually-hidden\">\n          <tr>\n            <th scope=\"col\">Model name</th>\n            <th scope=\"col\">Add link</th>\n            <th scope=\"col\">Change or view list link</th>\n          </tr>\n        </thead>\n        \n          \n            <tr class=\"model-group\">\n              <th scope=\"row\" id=\"auth-group\">\n                \n                  <a href=\"/admin/auth/group/\">Groups</a>\n                \n              </th>\n\n              \n                <td><a href=\"/admin/auth/group/add/\" class=\"addlink\" aria-describedby=\"auth-group\">Add</a></td>\n              \n\n              \n                \n                  <td><a href=\"/admin/auth/group/\" class=\"changelink\" aria-describedby=\"auth-group\">Change</a></td>\n                \n              \n            </tr>\n          \n        \n          \n            <tr class=\"model-user\">\n              <th scope=\"row\" id=\"auth-user\">\n                \n                  <a href=\"/admin/auth/user/\">Users</a>\n                \n              </th>\n\n              \n                <td><a href=\"/admin/auth/user/add/\" class=\"addlink\" aria-describedby=\"auth-user\">Add</a></td>\n              \n\n              \n                \n                  <td><a href=\"/admin/auth/user/\" class=\"changelink\" aria-describedby=\"auth-user\">Change</a></td>\n                \n              \n            </tr>\n          \n        \n      </table>\n    </div>\n  \n    <div class=\"app-datatypes module\">\n      <table>\n        <caption>\n          <a href=\"/admin/datatypes/\" class=\"section\" title=\"Models in the Datatypes application\">Datatypes</a>\n        </caption>\n        <thead class=\"visually-hidden\">\n          <tr>\n            <th scope=\"col\">Model name</th>\n            <th scope=\"col\">Add link</th>\n            <th scope=\"col\">Change or view list link</th>\n          </tr>\n        </thead>\n        \n          \n            <tr class=\"model-collection\">\n              <th scope=\"row\" id=\"datatypes-collection\">\n                \n                  <a href=\"/admin/datatypes/collection/\">Collections</a>\n                \n              </th>\n\n              \n                <td><a href=\"/admin/datatypes/collection/add/\" class=\"addlink\" aria-describedby=\"datatypes-collection\">Add</a></td>\n              \n\n              \n                \n                  <td><a href=\"/admin/datatypes/collection/\" class=\"changelink\" aria-describedby=\"datatypes-collection\">Change</a></td>\n                \n              \n            </tr>\n          \n        \n          \n            <tr class=\"model-document\">\n              <th scope=\"row\" id=\"datatypes-document\">\n                \n                  <a href=\"/admin/datatypes/document/\">Documents</a>\n                \n              </th>\n\n              \n                <td><a href=\"/admin/datatypes/document/add/\" class=\"addlink\" aria-describedby=\"datatypes-document\">Add</a></td>\n              \n\n              \n                \n                  <td><a href=\"/admin/datatypes/document/\" class=\"changelink\" aria-describedby=\"datatypes-document\">Change</a></td>\n                \n              \n            </tr>\n          \n        \n      </table>\n    </div>\n  \n    <div class=\"app-resources module\">\n      <table>\n        <caption>\n          <a href=\"/admin/resources/\" class=\"section\" title=\"Models in the Resources application\">Resources</a>\n        </caption>\n        <thead class=\"visually-hidden\">\n          <tr>\n            <th scope=\"col\">Model name</th>\n            <th scope=\"col\">Add link</th>\n            <th scope=\"col\">Change or view list link</th>\n          </tr>\n        </thead>\n        \n          \n            <tr class=\"model-httpresourcemock\">\n              <th scope=\"row\" id=\"resources-httpresourcemock\">\n                \n                  <a href=\"/admin/resources/httpresourcemock/\">Http resource mocks</a>\n                \n              </th>\n\n              \n                <td><a href=\"/admin/resources/httpresourcemock/add/\" class=\"addlink\" aria-describedby=\"resources-httpresourcemock\">Add</a></td>\n              \n\n              \n                \n                  <td><a href=\"/admin/resources/httpresourcemock/\" class=\"changelink\" aria-describedby=\"resources-httpresourcemock\">Change</a></td>\n                \n              \n            </tr>\n          \n        \n          \n            <tr class=\"model-shellresourcemock\">\n              <th scope=\"row\" id=\"resources-shel